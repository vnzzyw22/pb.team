# Copie para .env.local e preencha. Sem DATABASE_URL o site roda com dados
# de exemplo em memória (bom para desenvolver a interface).

# Connection string do Neon (Dashboard > Connect). Use a versão "pooled".
DATABASE_URL=

# "true" = modo demonstração: preenche o banco vazio com dados de exemplo e
# libera o botão "resetar demo" no painel.
DEMO=true

# Senha do painel do dono. Em modo demo, sem senha definida, vale "pbteam2019".
PAINEL_SENHA=

# Opcional: chave para assinar o cookie do painel (qualquer texto longo).
PAINEL_SEGREDO=

# Protege /api/cron (a Vercel preenche sozinha quando há cron configurado).
CRON_SECRET=
